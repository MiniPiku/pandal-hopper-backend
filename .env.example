# Copy to .env and fill in real values. NEVER commit .env.
#
# NOTE: an earlier .env was committed to git history (commit 9d4a47e) and the
# blob is still reachable. Every value below must be rotated before this
# service is exposed again. See README for the purge procedure.

# ---------- Database ----------
DB_URL=jdbc:postgresql://localhost:5432/pandal_hopper
DB_USER=postgres
DB_PASS=change_me

# ---------- JWT ----------
# Must be at least 32 bytes / 256 bits for HS256, or token signing throws at
# runtime on the first login. Generate with:  openssl rand -base64 48
jwt-Secret-Key=change_me_min_32_bytes_long_secret_value

# ---------- OAuth2 (Google) ----------
oauth2-google-clientId=your_google_client_id
oauth2-google-clientSecret=your_google_client_secret

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Frontend ----------
# Where OAuth2 login redirects after issuing a one-time exchange code.
app.frontend.callback-url=http://localhost:5173/auth/callback

# Comma-separated list of origins allowed to call this API.
app.cors.allowed-origins=http://localhost:5173
